help__assumeAgentRole="assume with specify agent role name [./go assumeAgentRole <agent role name>]"
task_assumeAgentRole() {
  local agent_role_name='tools-devsecops-cluster-marketplace-nonprod-agent-sa'
  local awsume_cache_folder="${HOME}/.awsume/cache"
  local cache_file="$awsume_cache_folder/aws-credentials-manual-sso"

  if test -d "$awsume_cache_folder" ; then
    echo "clearing $awsume_cache_folder"
    rm -rf $awsume_cache_folder
    mkdir $awsume_cache_folder
  fi
  
  echo "Assuming $agent_role_name.."
  local agent_role_creds=$(aws sts assume-role --role-arn "arn:aws:iam::688318228301:role/${agent_role_name}" --role-session-name $HOSTNAME)
  export AWS_SESSION_TOKEN=$(echo $agent_role_creds | jq -r .Credentials.SessionToken)
  export AWS_ACCESS_KEY_ID=$(echo $agent_role_creds | jq -r .Credentials.AccessKeyId)
  export AWS_SECRET_ACCESS_KEY=$(echo $agent_role_creds | jq -r .Credentials.SecretAccessKey)
  $(echo $agent_role_creds | jq -r .Credentials > $cache_file)
  echo "create aws cache at $cache_file"
}


