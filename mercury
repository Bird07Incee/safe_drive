help__test_coverage="Run test coverage"
task_test_coverage() {
  if runs_inside_gocd; then
    flutter_app flutter test --coverage test
    flutter_app flutter test --machine --coverage test > coverage.output
    flutter_app perl bin/lcov --remove coverage/lcov.info 'lib/views/*' 'lib/shared/pages/widgets/*' 'lib/configs/routes/*' 'lib/core/*' 'lib/core/dio_utils/*' 'lib/core/interceptors/*' 'lib/core/analytic_manager/*' 'lib/core/base/*' 'lib/core/dio/*' 'lib/core/dio/dio_utils/*' 'lib/core/dio/interceptors/*' 'lib/core/feature/*' 'lib/core/providers/*' 'lib/core/pages/widgets/*'  -o coverage/new_lcov.info
    flutter_app perl bin/genhtml coverage/new_lcov.info -o coverage coverage/new_lcov.info >coverage_result.log
  else
    flutter test --coverage test
    flutter test --machine --coverage test > coverage.output
    perl bin/lcov --remove coverage/lcov.info 'lib/views/*' 'lib/shared/pages/widgets/*' 'lib/configs/routes/*' 'lib/core/*' 'lib/core/analytic_manager/*' 'lib/core/base/*' 'lib/core/dio/*' 'lib/core/dio_utils/*' 'lib/core/interceptors/*' 'lib/core/dio/dio_utils/*' 'lib/core/dio/interceptors/*' 'lib/core/feature/*' 'lib/core/providers/*' 'lib/core/pages/widgets/*'  -o coverage/new_lcov.info
    perl bin/genhtml coverage/new_lcov.info -o coverage coverage/new_lcov.info >coverage_result.log
  fi
  echo "[INFO] Checking coverage..."
  RESULT=$(cat coverage_result.log)
  echo $RESULT
  RESULT=$(echo $RESULT | grep -o "lines......:.*")
  ar=($RESULT)
  COVERAGE=${ar[1]}
  END_INDEX=$(echo ${#COVERAGE})
  COVERAGE=${COVERAGE:0:END_INDEX-1}
  COVERAGE=$(printf "%.0f" $COVERAGE)

  echo "[INFO] Target coverage = $COVERAGE_TARGET%"
  echo "[INFO] Coverage = $COVERAGE%"

  if [ $COVERAGE -ge $COVERAGE_TARGET ]; then
    echo "[INFO] Coverage passed."
  else
    echo "[ERROR] Coverage failed."
    rm coverage_result.log
    exit 1
  fi
  rm coverage_result.log

}

