fetchSecret() {
  (
  account_name="$1"
  secret_name="$2"
  echo $secret_name
  assume_role $(account_id_for_name ${account_name}) "DeployApp"
  echo `aws secretsmanager get-secret-value --secret-id ${secret_name} --query SecretString --output text --region ap-southeast-1`
  )
}

account_id_for_name() {
  case $1 in
    tools) echo "688318228301";;
    dev) echo "246477751131";;
    qa) echo "246477751131";;
    int) echo "246477751131";;
    uat) echo "246477751131";;
    prod) echo "315858814413";;
  esac
}

assume_role() {
  account_id="$1"
  role="$2"

  credentials=$(aws sts assume-role --role-arn "arn:aws:iam::${account_id}:role/${role}" \
                                      --role-session-name initial --duration-seconds 2700 --region ap-southeast-1 | jq '.Credentials')
  export AWS_ACCESS_KEY_ID=$(echo "${credentials}" | jq -r .AccessKeyId)
  export AWS_SECRET_ACCESS_KEY=$(echo "${credentials}" | jq -r .SecretAccessKey)
  export AWS_SESSION_TOKEN=$(echo "${credentials}" | jq -r .SessionToken)
  unset AWS_SECURITY_TOKEN
}


