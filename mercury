help__publish="Create new tag on git withb gocd counter ver"
task_publish() {
    echo "Version: $VERSION"
    local TAG_NAME=$VERSION.$GO_PIPELINE_COUNTER
    if [ -z "$(git ls-remote origin refs/tags/$TAG_NAME)" ]
    then
        git config --global user.email "ks-auto-bay+gocd-agent-user@thoughtworks.com"
        git config --global user.name "ks-auto-bay+gocd-agent-user"
        git tag -a $TAG_NAME -m "Auto publish on pipeline"
        git push origin $TAG_NAME
        echo "Publish success => $TAG_NAME"
        echo "MERCURY_VERSION=${TAG_NAME}" > mercury-version.info
    else
        echo "Tag name: $TAG_NAME already on origin"
    fi
}


