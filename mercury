docker_ensure_volume() {
  docker volume inspect $1 >/dev/null 2>&1 || docker volume create $1 >/dev/null 2>&1
}

docker_run() {
  (
  local AWS_ACCESS_KEY_ID_prev="${AWS_ACCESS_KEY_ID}"
  local AWS_SECRET_ACCESS_KEY_prev="${AWS_SECRET_ACCESS_KEY}"
  local AWS_SESSION_TOKEN_prev="${AWS_SESSION_TOKEN}"

  if runs_inside_gocd ; then
    aws ecr get-login --no-include-email --region ap-southeast-1 | bash
  else #for new aws cli
    aws ecr get-login-password --region ap-southeast-1 | docker login --username AWS --password-stdin ${ECR_URL}
  fi

  if [[ -z "${DOCKER_IMAGE}" ]]; then
    echo -n "Building toolchain container; this might take a while..."
    DOCKER_IMAGE=$(docker build -f ${DOCKERFILE} . -q)
    echo " Done."
  else
    docker pull ${DOCKER_IMAGE}
  fi

  export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID_prev}"
  export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY_prev}"
  export AWS_SESSION_TOKEN="${AWS_SESSION_TOKEN_prev}"

  if runs_inside_gocd; then
    local args="-v godata:/godata -w $(pwd)"
  else
    local args="-it -v $(pwd):/workspace -w /workspace"
  fi
  echo -n "Running the task in the docker ${DOCKER_IMAGE}"
  DOCKER_ARGS="${DOCKER_ARGS} -v ${HOME}/.aws:/root/.aws"
  docker run --rm \
             --hostname $(hostname) \
             --env-file <(env | grep GO_) \
             --env-file <(env | grep AWS_) \
             --env-file <(env | grep SUPERAPP_) \
             ${args} ${DOCKER_ARGS} ${DOCKER_IMAGE} "$@"
  )
}

flutter_app() {
  DOCKER_IMAGE="${FLUTTER_IMAGE}"

  docker_ensure_volume superapp-gradle-cache
  docker_ensure_volume sonarqube-cache
  SSH_ARGS="-v ${HOME}/.ssh:/root/.ssh:cached"
  GRADLE_CACHE_ARGS="-v superapp-gradle-cache:/root/.gradle"
  SONARQUBE_CACHE_ARGS="-v sonarqube-cache:/root/.sonar/cache"
  FLUTTER_CACHE="-v ${HOME}/.pub-cache:/root/.pub-cache"
  DOCKER_ARGS="$DOCKER_ARGS $SSH_ARGS $GRADLE_CACHE_ARGS $SONARQUBE_CACHE_ARGS $FLUTTER_CACHE -v /var/run/secrets/eks.amazonaws.com/serviceaccount/:/var/run/secrets/eks.amazonaws.com/serviceaccount/ -v $(pwd):$(pwd) -w $(pwd)"
  for mod in $(env | grep NON_); do
    DOCKER_ARGS="${DOCKER_ARGS} -e ${mod}"
  done
  echo "${DOCKER_ARGS}"

  docker_run $@
}

